generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  MANUAL // new — covers cash handoffs and test triggers from the dashboard
}

model Donation {
  id                 String             @id @default(cuid())
  senderName         String
  message            String?
  amount             Decimal            @db.Decimal(12, 2)
  slipImageUrl       String?            // nullable now — manual triggers have no slip
  verificationStatus VerificationStatus @default(PENDING)
  slipOkReferenceId  String?            @unique
  slipOkRawResponse  Json?
  source             DonationSource     @default(FORM) // tracks how it entered the system
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([verificationStatus])
  @@index([createdAt])
  @@map("donations")
}

enum DonationSource {
  FORM    // real donor submitted via the public form
  MANUAL  // streamer triggered from the admin dashboard
}

// Single-row singleton — only one admin for this app.
// Seeded via `npx prisma db seed` using credentials from .env.
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

// Also a singleton — enforced by the fixed id "singleton".
// The backend always does upsert({ where: { id: "singleton" } })
// so there's never more than one row.
model Settings {
  id                  String    @id @default("singleton")

  // ── System ──────────────────────────────────────────────────────────────
  slipOkMode          String    @default("mock")
  minTtsAmount        Int       @default(0)
  profanityList       String    @default("")

  // ── Goal widget ──────────────────────────────────────────────────────────
  goalLabel           String    @default("Donation Goal")
  goalTargetAmount    Decimal   @default(0)   @db.Decimal(12, 2)
  goalCurrentAmount   Decimal   @default(0)   @db.Decimal(12, 2)
  goalEndsAt          DateTime?
  goalBarColor        String    @default("#38E1C6")
  goalTextColor       String    @default("#FFFFFF")
  goalFont            String    @default("Oswald")
  goalShowCountdown   Boolean   @default(true)
  goalShowPercent     Boolean   @default(true)

  // ── Top Donators widget ──────────────────────────────────────────────────
  topDonatorsLimit    Int       @default(5)
  topFont             String    @default("Oswald")
  topTextColor        String    @default("#FFFFFF")
  topAccentColor      String    @default("#FFB627")   // rank #1 highlight
  topBarColor         String    @default("#38E1C6")   // relative bar fill
  topLayout           String    @default("list")      // "list" | "podium"
  topShowBar          Boolean   @default(true)        // show relative bar per row

  // ── Timer widget ─────────────────────────────────────────────────────────
  timerEnabled        Boolean   @default(false)
  timerEndsAt         DateTime?
  timerBaseAmount     Decimal   @default(100) @db.Decimal(12, 2)
  timerBaseMinutes    Decimal   @default(1)   @db.Decimal(8, 4)
  timerFont           String    @default("IBM Plex Mono")
  timerTextColor      String    @default("#38E1C6")
  timerExpiredColor   String    @default("#FF3B5C")
  timerBackgroundColor String   @default("transparent")
  timerLayout         String    @default("digital")   // "digital" | "minimal" | "circle"
  timerAnimation      String    @default("pulse")     // "pulse" | "none" | "glow"

  // ── Donation Alert / Overlay widget ─────────────────────────────────────
  alertFont           String    @default("Oswald")
  alertTextColor      String    @default("#FFFFFF")
  alertAccentColor    String    @default("#38E1C6")   // amount, tally-light
  alertGifUrl         String    @default("")          // custom image/GIF shown on alert
  alertSoundUrl       String    @default("")          // custom sound URL (empty = default)
  alertAnimation      String    @default("slide-up")  // "slide-up" | "fade" | "bounce"
  alertDuration       Int       @default(7000)        // ms the card stays on screen
  alertTtsEnabled     Boolean   @default(true)
  alertShowGif        Boolean   @default(false)       // whether to show the gif overlay

  updatedAt           DateTime  @updatedAt
  @@map("settings")
}